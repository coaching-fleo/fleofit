    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "tailwindcss": "^4.2.4",
    "thinking-orbs": "^0.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
